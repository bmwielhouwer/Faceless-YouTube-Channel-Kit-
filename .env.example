# =============================================================================
# Faceless YouTube Kit — configuration template
# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# On Railway (or any host), set these in the dashboard instead of a file.
# Nothing in this file is a real key — replace every placeholder with your own.
# =============================================================================

# ------------------------------------------------------------------ SECRETS ---
# Mark these "sealed"/"secret" in your host where supported. Never share them.
ANTHROPIC_API_KEY=            # Claude — writes weekly scripts + upload copy
ELEVENLABS_API_KEY=          # ElevenLabs — text-to-speech voiceover
PEXELS_API_KEY=              # Pexels — content-aware stock B-roll (optional)
AIRTABLE_PAT=                # Airtable Personal Access Token (starts with "pat")
ZERNIO_API_KEY=              # Zernio — auto-post to TikTok + Facebook (optional)
# One Google OAuth client (Desktop app) powers Drive + Gmail + the YouTube upload.
# Mint the refresh token once locally with:  python -m tools.gdrive_auth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --------------------------------------------------------------- CONFIG / IDs ---
AIRTABLE_BASE_ID=                       # the base you duplicated from the template
AIRTABLE_VIDEO_LIBRARY_TABLE_ID=        # "Video Library" table id (tbl...)
AIRTABLE_TRENDING_TOPICS_TABLE_ID=      # "Trending Topics" table id (tbl...)
AIRTABLE_POSTING_SCHEDULE_TABLE_ID=     # "Posting Schedule" table id (tbl...)
YOUTUBE_CHANNEL_ID=                     # your channel id (UC...) — used in links
ELEVENLABS_VOICE_ID=                    # the voice id from your ElevenLabs library

# ---------------------------------------------------------- NICHE / BRANDING ---
# This is what makes the Kit YOURS. Change these to fit your channel + niche.
NICHE_TOPIC=your channel's niche, in a phrase (e.g. "budget travel tips for families")
CHANNEL_NAME=Your Channel Name
# How the AI should write your scripts (tone, structure, do's & don'ts):
SCRIPT_STYLE_PROMPT=Write in a clear, confident, engaging voice. Strong hook, real value with concrete examples, close with a subscribe CTA. No filler.
# Of every N generated titles, how many should be head-to-head "vs" comparisons:
COMPARISON_BIAS_RATIO=5/7
# Thumbnail + on-video accent color (hex). Default is an electric blue.
THUMBNAIL_ACCENT_COLOR=#1FA2FF
# Your local timezone (IANA name) for every scheduled hour below:
POSTING_TIMEZONE=America/New_York
# When videos render vs when they publish, in your local time:
POSTING_SCHEDULE=render 07:00, publish 08:00
# Which platforms to publish to (comma-separated). Anything omitted is skipped.
PLATFORMS=youtube,tiktok,facebook
# Optional affiliate/referral link appended to descriptions/captions:
AFFILIATE_LINK=

# ------------------------------------------------ Airtable field/status names ---
# Only change these if you renamed the columns/options in your base.
AIRTABLE_TITLE_FIELD=Video Title
AIRTABLE_SCRIPT_FIELD=ElevenLabs Script
AIRTABLE_STATUS_FIELD=Status
AIRTABLE_FACEBOOK_FIELD=Facebook Caption
AIRTABLE_YOUTUBE_DESC_FIELD=YouTube Description
AIRTABLE_ZERNIO_POSTED_FIELD=Zernio Posted
AIRTABLE_TRIGGER_STATUS=Scripted
AIRTABLE_PROCESSING_STATUS=Processing
AIRTABLE_DONE_STATUS=Video Ready
AIRTABLE_PUBLISHED_STATUS=Posted
AIRTABLE_ERROR_STATUS=Error
AIRTABLE_QUEUED_STATUS=Queued
POLL_INTERVAL_SECONDS=300

# --------------------------------------------------------------- ElevenLabs ----
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEAKER_BOOST=true

# ------------------------------------------------------ Render + music/B-roll --
# ffmpeg = self-hosted rendering, $0 (recommended). Creatomate is legacy/optional.
RENDER_BACKEND=ffmpeg
MUSIC_VOLUME=0.2
# MUSIC_URL=            # optional hosted music bed; else assets/music.mp3 is used

# ------------------------------------------------------ Where the MP4 lands ----
STORAGE_PROVIDER=gdrive
GDRIVE_FOLDER_ID=       # root Google Drive folder id for finished videos
# Optional per-type subfolders (default to GDRIVE_FOLDER_ID when unset):
# GDRIVE_FOLDER_YOUTUBE=
# GDRIVE_FOLDER_TIKTOK=
# GDRIVE_FOLDER_SHORTS=
# GDRIVE_FOLDER_REELS=

# ---------------------------------------------------- Gmail "ready" emails -----
NOTIFY_EMAIL=            # where the "video ready / published" emails go
GMAIL_ADDRESS=           # the Gmail address that sends them
# GMAIL_APP_PASSWORD=    # only needed for the SMTP fallback (not the Gmail API)

# ---------------------------------------------------- On-demand webhook --------
# Shared secret required to fire a render via POST /trigger. Strongly recommended
# since the endpoint is public. Sent as header X-Trigger-Token.
TRIGGER_TOKEN=

# ---------------------------------------------------- Zernio account overrides -
# Usually auto-discovered from your Zernio account; set only to force specific IDs.
# ZERNIO_TIKTOK_ACCOUNT_ID=
# ZERNIO_FACEBOOK_ACCOUNT_ID=
